{
  "events": [
    {
      "id": "action_network:4d3da9db-4e6d-4099-b37d-3c99e1d87e83",
      "name": "Health Justice Potluck Picnic",
      "date": "2026-08-30T14:00:00Z",
      "date_formatted": "2:00 PM, Sunday August 30, 2026",
      "month_year": "2026-08",
      "month_label": "August 2026",
      "status": "confirmed",
      "description": "<p>Join comrades and friends from various organizations fighting for health justice through the New York Health Act for a potluck social!</p>",
      "browser_url": "https://actionnetwork.org/events/health-justice-potluck-picnic",
      "signup_url": "https://actionnetwork.org/events/health-justice-potluck-picnic",
      "location": "1802 E 65th St",
      "borough": "New York"
    },
    {
      "id": "action_network:5acfe794-eda8-4ee8-9b24-dce33105103f",
      "name": "New York Health Act 101",
      "date": "2026-09-03T18:30:00Z",
      "date_formatted": "6:30 PM, Thursday September 3, 2026",
      "month_year": "2026-09",
      "month_label": "September 2026",
      "status": "confirmed",
      "description": "<p>Come learn about the New York Health Act, a bill to de-privatize healthcare and send the extortionist insurance companies packing. No more premiums, deductibles, and co pays! No denials of care or medication and no restricted networks! There will be time Q&A and discussion.</p>",
      "browser_url": "https://actionnetwork.org/events/back-groundintro-to-new-york-health-act-2",
      "signup_url": "https://actionnetwork.org/events/back-groundintro-to-new-york-health-act-2",
      "location": "14 Jefferson St.",
      "borough": "New York"
    },
    {
      "id": "action_network:26cecdb6-dfd2-44e8-a67f-7bf96e2896eb",
      "name": "New York Health Act canvass at labor day rally and march",
      "date": "2026-09-08T16:30:00Z",
      "date_formatted": "4:30 PM, Tuesday September 8, 2026",
      "month_year": "2026-09",
      "month_label": "September 2026",
      "status": "confirmed",
      "description": "<p>Join the NYC DSA healthcare working group 4th annual canvass labor day canvass. We will celebrate with rank and file union members and ask them to lead the way, or work with us, to bring universal health care to New York State and finally get healthcare off the bargaining table so we go after better wages. &nbsp;At 7:30 after the official Central Labor Council event, we invite sisters and brothers to a debrief and discussion of next steps at a location TBD. Once again, thanks to the working people of New York for making this celebration honoring organized labor possible. Canvass training for new comrades or veterans alike Aug. 31st: bit.ly/26Labor</p>",
      "browser_url": "https://actionnetwork.org/events/new-york-health-act-canvass-at-labor-day-rally-and-march",
      "signup_url": "https://actionnetwork.org/events/new-york-health-act-canvass-at-labor-day-rally-and-march",
      "location": "135 Broadway",
      "borough": "New York"
    },
    {
      "id": "action_network:047e34ee-18f8-4d2f-829a-1ce01c033fd2",
      "name": "NYC DSA healthcare working group present a NYHA 101 featuring senator Gustavo Rivera",
      "date": "2026-09-17T06:30:00Z",
      "date_formatted": "6:30 AM, Thursday September 17, 2026",
      "month_year": "2026-09",
      "month_label": "September 2026",
      "status": "confirmed",
      "description": "<p>Join us if you are new to organizing for, or just want to know your way around basic talking points, for the New York Health Act. Our incomparable head of the NYS senate health committee, Gustavo Rivera will give a background and update on the legislative fight in Albany to pass statewide Medicare for All bill. We will have a QA and discussion at the end of our presentation.</p>",
      "browser_url": "https://actionnetwork.org/events/nyc-dsa-healthcare-working-group-present-a-nyha-101-featuring-senator-gustavo-rivera",
      "signup_url": "https://actionnetwork.org/events/nyc-dsa-healthcare-working-group-present-a-nyha-101-featuring-senator-gustavo-rivera",
      "location": "250 Bedford Park Blvd W",
      "borough": "Bronx"
    },
    {
      "id": "action_network:41def52b-365a-4bc1-aba5-c21414011213",
      "name": "Daniel's Day",
      "date": "2026-09-19T10:00:00Z",
      "date_formatted": "10:00 AM, Saturday September 19, 2026",
      "month_year": "2026-09",
      "month_label": "September 2026",
      "status": "confirmed",
      "description": "<p>Resource fair for mental health and wellness in memory of Daniel Prude who was killed by police in a mental health distress call.</p>",
      "browser_url": "https://actionnetwork.org/events/daniels-day",
      "signup_url": "https://actionnetwork.org/events/daniels-day",
      "location": "41-15 104th St",
      "borough": "Queens"
    }
  ],
