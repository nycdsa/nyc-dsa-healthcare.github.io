  "events": [
    {
      "id": "action_network:b471a2ba-052b-49f6-8b5b-fb2673dfc6b3",
      "name": "Healthcare Working Group September Social ",
      "date": "2026-09-27T13:30:00Z",
      "date_formatted": "1:30 PM, Sunday September 27, 2026",
      "month_year": "2026-09",
      "month_label": "September 2026",
      "status": "confirmed",
      "description": "<p><img src=\"https://can2-prod.s3.amazonaws.com/uploads/data/001/161/634/original/screenshot_2026-09-19_at_32218-pm.png\">Join us for a hang out in Prospect Park! Feel free to bring drinks, snacks, games and anything else. All are welcome!</p>",
      "browser_url": "https://actionnetwork.org/events/healthcare-working-group-september-social",
      "signup_url": "https://actionnetwork.org/events/healthcare-working-group-september-social",
      "location": "95 Prospect Park West",
      "borough": "Brooklyn"
    },
    {
      "id": "action_network:dab321d8-c427-4449-a9ec-d315ffb138df",
      "name": "Power Mapping for the New York Health Act",
      "date": "2026-10-04T13:00:00Z",
      "date_formatted": "1:00 PM, Sunday October 4, 2026",
      "month_year": "2026-10",
      "month_label": "October 2026",
      "status": "confirmed",
      "description": "<p>Join healthcare workers, union members, and organizers for an IN PERSON <strong>Power Mapping for the New York Health Act</strong> organizing session! </p><p><span></span></p><p>Together, we\u2019ll map our unions, workplaces, and existing relationships to better understand where we have power, where we need to build it, and how we can coordinate NYHA organizing across unions and workplaces throughout the city.</p><p>Come ready to map, strategize, and identify concrete next steps for building an organized labor movement for universal healthcare in New York!</p><p><strong>The event will take place in NYC. The exact location and additional event details will be sent to registered attendees before the event. Please keep an eye on your email for updates.</strong><br></p>",
      "browser_url": "https://actionnetwork.org/events/power-mapping-for-the-new-york-health-act",
      "signup_url": "https://actionnetwork.org/events/power-mapping-for-the-new-york-health-act",
      "location": "TBD",
      "borough": "TBD"
    },
    {
      "id": "action_network:3380aec2-1f88-4a53-b9a4-da4f9379ea4e",
      "name": "Art Build for NYHA ",
      "date": "2026-10-05T17:00:00Z",
      "date_formatted": "5:00 PM, Monday October 5, 2026",
      "month_year": "2026-10",
      "month_label": "October 2026",
      "status": "confirmed",
      "description": "<p>We plan on screen printing pulling squeegee,  drying printed material, painting banners with brush work and maybe stencil,, and sewing bike bibbs, and perhaps printing posters as well</p><p>The correct address will be sent upon RSVP </p>",
      "browser_url": "https://actionnetwork.org/events/art-build-for-nyha",
      "signup_url": "https://actionnetwork.org/events/art-build-for-nyha",
      "location": "215 w 23rd st",
      "borough": "New York"
    }
  ],
