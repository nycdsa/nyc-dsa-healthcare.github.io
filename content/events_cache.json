    {
      "id": "action_network:dab321d8-c427-4449-a9ec-d315ffb138df",
      "name": "NYHA LABOR POWER MAPPING",
      "date": "2026-10-04T13:00:00Z",
      "date_formatted": "1:00 PM, Sunday October 4, 2026",
      "month_year": "2026-10",
      "month_label": "October 2026",
      "status": "confirmed",
      "description": "<div><strong>Join us Sunday, October 4th for NYHA Labor Power Mapping!</strong></div><div><br></div><div>We\u2019re bringing together NYC union members and advocates to learn and practice power mapping! We\u2019ll look at our unions / workplaces, identify existing relationships, and identify where we already have relationships or where we need to build them.</div><div><br></div><div>We\u2019ll be working through our actual unions and workplaces, <strong>so please bring a laptop!</strong></div><div><br></div><div>\ud83d\udcc5 Sunday, October 4</div><div>\u23f0 1\u20133 PM</div><div>\ud83d\udccd DSA Midtown, 315 W 35th St</div><div>\ud83d\udcbb Bring your laptop</div><div><br></div><div>Due to the nature of this work, this session is in person only</div>",
      "browser_url": "https://actionnetwork.org/events/power-mapping-for-the-new-york-health-act",
      "signup_url": "https://actionnetwork.org/events/power-mapping-for-the-new-york-health-act",
      "location": "315 W 35th St",
      "borough": "New York "
    },
    {
      "id": "action_network:3380aec2-1f88-4a53-b9a4-da4f9379ea4e",
