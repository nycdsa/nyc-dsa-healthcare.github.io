  "events": [
    {
      "id": "action_network:f558831d-ab05-490a-9871-105ca5afe391",
      "name": "Saratoga Rally/Presser/Speak Out for New York Health Act",
      "date": "2026-12-05T12:00:00Z",
      "date_formatted": "12:00 PM, Saturday December 5, 2026",
      "month_year": "2026-12",
      "month_label": "December 2026",
      "status": "confirmed",
      "description": "<p>This will be a visibility event on the Saturday following the  Democratic assembly retreat &nbsp;and on the eve of the senate retreat. We are demanding that legislators prioritize the New York Health Act in the upcoming session. Earlier in the week we will hold a massive statewide phone-bank for the same purpose.  <br>To reserve a seat on the bus and get more info about transportation please fill out this form:<br>https://docs.google.com/forms/d/e/1FAIpQLSdmc-L4ZBhmDGqdvl0sgdvDWqoKVDNHl5HT9UvNXn6J0ERmQQ/viewform?usp=sharing&ouid=116693530792807551209</p><div>7am NYC: Bus boards in NYC at 40 East Union Square (between 16 & 17 sts)</div><div>Carpool meetup times vary from across the state, keep an eye on your email for info.</div><div>12/Noon to 2PM: Rally in Saratoga!</div><div><br></div><p><br></p>",
      "browser_url": "https://actionnetwork.org/events/saratoga-rallypresserspeak-out-for-new-york-health-act",
      "signup_url": "https://actionnetwork.org/events/saratoga-rallypresserspeak-out-for-new-york-health-act",
      "location": "25 East Congress Street",
      "borough": "Saratoga Springs"
    },
