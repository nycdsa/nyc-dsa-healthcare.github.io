      "id": "action_network:0e6f6e9a-99d4-4a97-a3da-f359fc911727",
      "name": "Healthcare Working Group November General Meeting",
      "date": "2026-11-21T10:30:00Z",
      "date_formatted": "10:30 AM, Saturday November 21, 2026",
      "month_year": "2026-11",
      "month_label": "November 2026",
      "status": "confirmed",
      "description": "<p> Get plugged into the healthcare working group at our November General Meeting</p><p>Agenda:</p><p>1) Healthcare for All resolution debrief and next steps</p><p>2) planning HCWG project connecting people to health coverage</p><p>3) Healthcare Ripoff Town Hall slides, training the trainers</p>",
      "browser_url": "https://actionnetwork.org/events/healthcare-working-group-november-general-meeting-3",
      "signup_url": "https://actionnetwork.org/events/healthcare-working-group-november-general-meeting-3",
